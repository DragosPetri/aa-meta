{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attach-meta/base/move",
  "description": "Base schema for the move command. Src is a variadic positional (source path); --to is required.",
  "type": "object",
  "properties": {
    "src": { "type": "array", "items": { "type": "string" }, "x-positional": true },
    "to":  { "type": "array", "items": { "type": "string" } }
  },
  "required": ["to"]
}
